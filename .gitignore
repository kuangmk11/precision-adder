# local Numbers copy of the v2.2 BOM, which lives in reference/ alongside the CSV
reference/BOM_precision-adder-final-v2.2.numbers

# local session archives (raw Claude Code transcripts)
docs/*.jsonl

# machine-local Claude Code settings
.claude/settings.local.json
.claude/*.local.json

# VS Code Local History
.history/

# other editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS / filesystem junk
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# KiCad ERC/DRC output from tools/kicad-check.sh
.kicadcheck/

# KiCad per-user local project state
*.kicad_prl

# KiCad automatic schematic/board backups
*-backups/

# manual "save as" copies kept alongside the real file
* - bak.*
*-bak.*

# python bytecode
__pycache__/
*.pyc

# KiCad lock files (present while a project is open)
~*.lck
*.lck

# KiCad autosave, fp cache, generated reports, routing exchange
_autosave-*
fp-info-cache
*-erc.rpt
*-drc.rpt
*.dsn
*.ses

# KiCad 3D board export: 9 MB, regenerable with
#   kicad-cli pcb export step docs/v3-adder.kicad_pcb
# and it changes wholesale on every board edit. The panel export is small
# enough to keep; this one is not.
docs/boards.step
